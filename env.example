# ═══════════════════════════════════════════════════════════════════
#  DIGITRUST BOT — قالب المتغيرات
#  انسخ القيم إلى Railway → Variables (لا ترفع هذا الملف مملوءًا)
# ═══════════════════════════════════════════════════════════════════

# ── إلزامية ────────────────────────────────────────────────────────
BOT_TOKEN=
ADMIN_IDS=
ADMIN_ID=
DB_PATH=/app/data/store.db

# ── المتجر والدعم ──────────────────────────────────────────────────
STORE_NAME=MY DIGITAL STORE
SUPPORT_USERNAME=
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=

# ── الاشتراك الإجباري (اتركها فارغة لتعطيلها) ──────────────────────
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_LINK=
REQUIRED_GROUP_ID=
REQUIRED_GROUP_LINK=

# ── قنوات النشر التلقائي ───────────────────────────────────────────
UPDATES_CHANNEL_ID=
UPDATES_GROUP_ID=

# ── الدفع: USDT عبر Binance ────────────────────────────────────────
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=
USDT_TON_ADDRESS=
USDT_TON_MEMO=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ID=

# ── الدفع: CryptoBot ───────────────────────────────────────────────
CRYPTOBOT_TOKEN=
CRYPTOBOT_BOT_URL=https://t.me/CryptoBot

# ── اختيارية ───────────────────────────────────────────────────────
MIN_DEPOSIT=1.00
REFERRAL_REWARD=0.20
CHATGPT_BOT_TOKEN=
CHATGPT_BOT_USERNAME=
LOG_LEVEL=INFO
NODE_ENV=production

# Shop Assistant (read-only AI agent)
# Set EITHER key. OpenAI is used automatically if it is the only one present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides. AGENT_PROVIDER is openai | anthropic.
AGENT_PROVIDER=
AGENT_MODEL=
# Optional: a fixed token so the link survives restarts. Leave empty to auto-generate.
AGENT_TOKEN=
